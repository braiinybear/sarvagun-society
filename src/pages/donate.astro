---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Donate" description="Support Sarvagun Society. Your donation helps us educate children, develop rural communities, and protect the environment in Uttarakhand.">
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[var(--spacing-page)] px-4 lg:px-6">
      <h1 class="text-4xl lg:text-5xl font-heading font-bold mb-4">Support Our Cause</h1>
      <p class="text-lg text-text-muted max-w-3xl mb-12">Your support, in any form, helps us make a real difference in the lives of underprivileged communities in Uttarakhand.</p>

      <div class="space-y-10">
        <div class="reveal">
          <h2 class="text-2xl mb-3">Sponsor a Child's Education</h2>
          <p class="text-text-muted leading-relaxed mb-4">Support a child's education journey. Many bright children from underprivileged backgrounds cannot continue their studies due to financial constraints. Your sponsorship can shape their future.</p>
          <a href="mailto:sarvagun@live.com" class="inline-flex bg-primary text-white font-semibold px-5 py-2 text-sm">Contact Us to Sponsor</a>
        </div>

        <div class="reveal">
          <h2 class="text-2xl mb-3">Donate Old Items</h2>
          <p class="text-text-muted leading-relaxed mb-4">Donate old clothes, shoes, toys, books, stationary, or unused household items. What is unused for you can be invaluable for someone in need.</p>
          <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-2 text-sm">
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">Old Clothes</li>
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">Shoes &amp; Slippers</li>
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">Toys &amp; Games</li>
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">Books &amp; Stationery</li>
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">Crockery &amp; Utensils</li>
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">School Bags</li>
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">Blankets &amp; Warm Clothes</li>
            <li class="bg-bg-muted border border-border px-4 py-2 text-text">Electronics</li>
          </ul>
        </div>

        <div class="reveal">
          <h2 class="text-2xl mb-3">Donate a Desktop/Laptop</h2>
          <p class="text-text-muted leading-relaxed">Donate your used or old computer. Even if it is not fully functional, it can help children who have never seen a computer. We refurbish and donate them to government schools.</p>
        </div>

        <div class="reveal">
          <h2 class="text-2xl mb-3">Adopt a School</h2>
          <p class="text-text-muted leading-relaxed">Partner with us to adopt underprivileged schools lacking quality education and basic facilities. We need volunteers, teachers, books, and financial support for this initiative.</p>
        </div>

        <div class="reveal border border-festive/30 p-6 bg-festive/5">
          <h2 class="text-2xl mb-3 text-festive">Make a Financial Donation</h2>
          <p class="text-text-muted leading-relaxed mb-6">All donations to the society are exempted under <strong>80-G of the Income Tax Act, 1961</strong>.</p>
          <div class="bg-white p-6 border border-border">
            <h3 class="font-semibold mb-3">Bank Details</h3>
            <div class="space-y-1 text-sm">
              <p><strong>Account Name:</strong> Sarvagun Society</p>
              <p><strong>Bank:</strong> Indian Overseas Bank</p>
              <p><strong>Account No.:</strong> 321301000001156</p>
              <p><strong>IFSC Code:</strong> IOBA0003213</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
