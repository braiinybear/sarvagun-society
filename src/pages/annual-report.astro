---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Annual Report" description="Download the annual activity report of Sarvagun Society.">
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[var(--spacing-page)] px-4 lg:px-6 text-center">
      <h1 class="text-4xl lg:text-5xl font-heading font-bold mb-6">Annual Report</h1>
      <p class="text-text-muted max-w-2xl mx-auto mb-8">View and download our annual activity report to learn about our achievements, programs, and financial transparency.</p>
      <a href="/reports/activity-report-2010.doc" class="inline-flex bg-primary text-white font-semibold px-8 py-4 rounded-lg hover:bg-primary-hover transition-colors text-lg gap-2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download Annual Report 2010
      </a>
      <p class="text-sm text-text-muted mt-3">PDF format | Size: ~3.5 MB</p>
    </div>
  </section>
</BaseLayout>
