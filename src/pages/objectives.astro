---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Objectives" description="The main objectives of Sarvagun Society — rural development, education, environmental awareness, and community empowerment in Uttarakhand.">
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[var(--spacing-page)] px-4 lg:px-6">
      <h1 class="text-4xl lg:text-5xl font-heading font-bold mb-8">Our Objectives</h1>
      <div class="space-y-6">
        <div class="bg-bg-card rounded-lg border border-border p-6 lg:p-8">
          <div class="flex gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-soft flex items-center justify-center text-primary font-heading font-bold">1</span>
            <div>
              <h2 class="font-heading font-bold text-xl mb-2">Rural &amp; Community Development</h2>
              <p class="text-text-muted leading-relaxed">To work for the development of below poverty line families in Uttarakhand through socio-economic initiatives.</p>
            </div>
          </div>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6 lg:p-8">
          <div class="flex gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-soft flex items-center justify-center text-primary font-heading font-bold">2</span>
            <div>
              <h2 class="font-heading font-bold text-xl mb-2">Media &amp; Awareness</h2>
              <p class="text-text-muted leading-relaxed">To disseminate initiatives undertaken for the poor in traditional sectors of society such as agriculture, handicrafts, animal husbandry etc. through newspapers, magazines, documentary films, and multi-media presentations.</p>
            </div>
          </div>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6 lg:p-8">
          <div class="flex gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-soft flex items-center justify-center text-primary font-heading font-bold">3</span>
            <div>
              <h2 class="font-heading font-bold text-xl mb-2">Education &amp; Training Centers</h2>
              <p class="text-text-muted leading-relaxed">To set up, establish, own, promote, run and manage formal and non-formal media centers which can be used for educating and training BPL families and to conduct research in rural areas.</p>
            </div>
          </div>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6 lg:p-8">
          <div class="flex gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-soft flex items-center justify-center text-primary font-heading font-bold">4</span>
            <div>
              <h2 class="font-heading font-bold text-xl mb-2">Eradication of Illiteracy</h2>
              <p class="text-text-muted leading-relaxed">To work for the eradication of illiteracy by undertaking innovative schemes for education such as creating adult education centers, evening schools, workshops on moral and value-based education, and education through mobile multimedia units.</p>
            </div>
          </div>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6 lg:p-8">
          <div class="flex gap-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-soft flex items-center justify-center text-primary font-heading font-bold">5</span>
            <div>
              <h2 class="font-heading font-bold text-xl mb-2">Publications &amp; Advocacy</h2>
              <p class="text-text-muted leading-relaxed">To arrange for the production and publication of literature and audio-visuals on rural development, women empowerment, and issues related to holistic healing of the poor.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
