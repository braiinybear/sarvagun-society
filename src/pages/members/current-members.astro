---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionList from '../../components/SectionList.astro';
---

<BaseLayout title="Current Members" description="Current board members, founder members, associate members, and general members of Sarvagun Society.">
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[var(--spacing-page)] px-4 lg:px-6">
      <h1 class="text-4xl lg:text-5xl font-heading font-bold mb-4">Current Members</h1>
      <p class="text-text-muted mb-10">Meet the dedicated team behind Sarvagun Society.</p>

      <h2 class="text-2xl font-heading font-bold mb-6 text-primary">Board Members</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {[
          ['Ankit Sharma', 'President'],
          ['Rajeev Gurung', 'Vice President'],
          ['Yaten Singh Negi', 'Secretary'],
          ['Amit Kotal', 'Treasurer'],
        ].map(([name, role]) => (
          <div class="bg-bg-card rounded-lg border border-border p-6 text-center">
            <div class="w-14 h-14 rounded-full bg-primary-soft flex items-center justify-center mx-auto mb-3">
              <span class="text-lg font-heading font-bold text-primary">{name.split(' ').map(n => n[0]).join('')}</span>
            </div>
            <h3 class="font-heading font-bold">{name}</h3>
            <p class="text-xs text-text-muted">{role}</p>
          </div>
        ))}
      </div>

      <SectionList title="Founder Members" items={['Ankit Sharma', 'Shobhit Sharma', 'Rahul Rawat', 'Harshit Sharma', 'Lalit Singh Pundir', 'Ankur Rana', 'Sarika Thapa', 'Yaten Singh Negi']} />
      <SectionList title="Associate Members" items={['Sudheer Rawat', 'Meenal Kuksal', 'Dinesh Menaria']} />
      <SectionList title="General Members" items={['Rajat Rana', 'Divesh Rustogi', 'Gourav Uniyal', 'Sankalp Saxena', 'Balbinder Chauhan', 'Akarsh Aggarwal', 'Nikita Kuksal', 'Nitin Rawat', 'Amit Rawat', 'Arpit Sharma', 'Shubham Tripathi', 'Ankit Goyal', 'Lalit Mohan Bhatt', 'Dharmesh Narula', 'Sudeep Gupta']} />
    </div>
  </section>
</BaseLayout>

