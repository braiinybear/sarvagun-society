---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Volunteers" description="Volunteer with Sarvagun Society — contribute your time and skills to empower communities in Uttarakhand.">
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[var(--spacing-page)] px-4 lg:px-6">
      <h1 class="text-4xl lg:text-5xl font-heading font-bold mb-4">Volunteer With Us</h1>
      <p class="text-lg text-text-muted mb-10">We recognize that contributions of time and talent are just as important as financial contributions.</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-bg-card rounded-lg border border-border p-6">
          <h2 class="font-heading font-bold text-lg mb-3 text-primary">Academic</h2>
          <ul class="space-y-2 text-sm text-text-muted">
            <li>Teaching</li>
            <li>Preparing teaching-learning aids</li>
            <li>Latent talent development (Theatre, Dance, Singing, Painting)</li>
            <li>SUPW (Gardening, Sanitation, Tree Plantation)</li>
          </ul>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6">
          <h2 class="font-heading font-bold text-lg mb-3 text-primary">Community Programs</h2>
          <ul class="space-y-2 text-sm text-text-muted">
            <li>Campaigning on various issues</li>
            <li>Community mobilization and participation</li>
          </ul>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6">
          <h2 class="font-heading font-bold text-lg mb-3 text-primary">Institutional Care</h2>
          <ul class="space-y-2 text-sm text-text-muted">
            <li>Counseling and spending time with children</li>
            <li>English conversation practice</li>
            <li>Latent talent development</li>
            <li>Academic support</li>
          </ul>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6">
          <h2 class="font-heading font-bold text-lg mb-3 text-primary">Special Unit (Differently-abled)</h2>
          <ul class="space-y-2 text-sm text-text-muted">
            <li>Spend time with children</li>
            <li>Introduce learning processes</li>
            <li>Training in creative exercises</li>
          </ul>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6">
          <h2 class="font-heading font-bold text-lg mb-3 text-primary">Corporate Office</h2>
          <ul class="space-y-2 text-sm text-text-muted">
            <li>Document design</li>
            <li>Computer classes</li>
            <li>Software products</li>
            <li>Trainings and process documentation</li>
            <li>Research and fundraising</li>
            <li>Administrative support</li>
          </ul>
        </div>
        <div class="bg-bg-card rounded-lg border border-border p-6">
          <h2 class="font-heading font-bold text-lg mb-3 text-primary">Education on Wheels</h2>
          <ul class="space-y-2 text-sm text-text-muted">
            <li>Door-to-door surveys</li>
            <li>Data analysis</li>
          </ul>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="/members/join-us" class="inline-flex bg-primary text-white font-semibold px-8 py-3 rounded-lg hover:bg-primary-hover transition-colors">Sign Up as Volunteer</a>
      </div>
    </div>
  </section>
</BaseLayout>
