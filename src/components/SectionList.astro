---
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<div class="mb-10">
  <h2 class="text-2xl font-heading font-bold mb-4 text-primary">{title}</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
    {items.map(name => (
      <div class="bg-bg-card rounded-lg border border-border px-4 py-3 text-sm text-text">{name}</div>
    ))}
  </div>
</div>
