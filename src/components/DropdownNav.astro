---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="relative group">
  <button class="flex items-center gap-1 text-xs xl:text-sm font-semibold text-text hover:text-primary hover:bg-primary-soft/50 transition-colors px-1.5 xl:px-2.5 py-1.5 rounded-lg cursor-pointer" aria-expanded="false">
    {label}
    <svg width="10" height="10" viewBox="0 0 12 12" fill="none" class="mt-0.5"><path d="M3 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
  </button>
  <div class="absolute top-full left-0 mt-1 w-56 bg-bg-card rounded shadow-lg border border-border opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2 z-50">
    <slot />
  </div>
</div>
